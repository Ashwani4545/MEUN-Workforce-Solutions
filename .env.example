# ---- Auth / Sessions ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# Required. Works with any Postgres provider (Neon, Supabase, Railway, RDS, ...).
# On serverless hosts use the provider's *pooled* connection string.
# Example: postgres://user:password@host:5432/meun?sslmode=require
DATABASE_URL=
# Only set to "false" for a local database without TLS.
# DATABASE_SSL=false
# Max connections per server instance (keep small on serverless). Default 5.
# DATABASE_POOL_MAX=5
#
# Create the tables and load the worker catalogue once per database:
#   npm run db:setup

# ---- Contact form / notifications ----
# No SMTP credentials are ever used client-side. If set, contact submissions
# are also emailed via this provider's HTTP API; they are always stored in the
# database.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@meun.in

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MEUN
