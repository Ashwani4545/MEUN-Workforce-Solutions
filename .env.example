# ---- Auth / Sessions ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=development

# ---- Data layer ----
# This build ships with a local JSON-file data store at /data (see lib/db.ts)
# so the site runs with zero external infra out of the box.
# Swap DATA_DRIVER to "postgres" once your real database is ready and provide:
DATA_DRIVER=json
DATABASE_URL=postgres://user:password@localhost:5432/meun
REDIS_URL=redis://localhost:6379

# ---- Contact form / notifications ----
# No SMTP credentials are ever used client-side. If set, contact submissions
# are emailed via this provider's HTTP API; otherwise they are stored in
# /data/contact-submissions.json for the admin to review.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@meun.in

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MEUN
