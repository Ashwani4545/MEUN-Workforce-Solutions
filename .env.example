# ---- Auth / Sessions ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# Required. Works with any Postgres provider (Neon, Supabase, Railway, RDS, ...).
# On serverless hosts use the provider's *pooled* connection string.
# Example: postgres://user:password@host:5432/meun?sslmode=require
DATABASE_URL=
# Only set to "false" for a local database without TLS.
# DATABASE_SSL=false
# Max connections per server instance (keep small on serverless). Default 5.
# DATABASE_POOL_MAX=5
#
# Tables are created automatically by `npm run build` when DATABASE_URL is set.
# Load the worker catalogue once per database (replace data/workers.json with
# real records first):
#   npm run seed

# ---- Worker marketplace switch ----
# OFF by default. While off, the worker listing, worker profiles and online
# booking (pages and APIs) are closed and visitors see an "opening soon" page;
# the enquiry form, "join as a professional" form, sign-up and login keep
# working. The bundled data/workers.json is SAMPLE data, so set this to "true"
# only after loading real, verified worker records (`npm run seed`).
# MARKETPLACE_ENABLED=true

# ---- Contact form / notifications ----
# No SMTP credentials are ever used client-side. If set, contact submissions
# are also emailed via this provider's HTTP API; they are always stored in the
# database.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@meun.in

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MEUN
